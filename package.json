{
  "name": "nextjs-postgresql-template",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "multiplayer:dev": "tsx multiplayer/server.ts",
    "multiplayer:cloudflare:dev": "wrangler dev --config multiplayer/cloudflare/wrangler.toml",
    "multiplayer:cloudflare:deploy": "wrangler deploy --config multiplayer/cloudflare/wrangler.toml",
    "multiplayer:cloudflare:smoke": "node multiplayer/cloudflare/smoke-test.mjs",
    "multiplayer:cloudflare:routes": "tsx multiplayer/cloudflare/route-test.ts",
    "test:remote-interpolation": "tsx src/game/remoteInterpolation.test.ts",
    "test:network-diagnostics": "tsx src/game/networkDiagnostics.test.ts",
    "test:network-snapshot-scheduler": "tsx src/game/networkSnapshotScheduler.test.ts",
    "test:cloudflare-snapshot-delta": "tsx src/game/cloudflareSnapshotDelta.test.ts",
    "test:cloudflare-multiplayer-identity": "tsx src/game/cloudflareMultiplayerIdentity.test.ts",
    "test:multiplayer-maps": "tsx src/game/maps.test.ts",
    "test:cosmetics": "tsx src/game/cosmetics.test.ts",
    "test:driver": "tsx src/game/driver.test.ts",
    "multiplayer:measure": "node multiplayer/network-measurement.mjs",
    "multiplayer:measure:browser": "node multiplayer/browser-network-measurement.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@colyseus/sdk": "^0.18.10",
    "@colyseus/ws-transport": "^0.18.5",
    "@types/three": "^0.187.0",
    "colyseus": "^0.18.12",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "next": "^16.4.6",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.4.6",
    "playwright-core": "1.65.1",
    "postcss": "8.5.23",
    "tailwindcss": "4.1.17",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "wrangler": "^4.43.0",
    "ws": "^8.23.0"
  }
}
